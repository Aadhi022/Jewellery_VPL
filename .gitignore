# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files — never commit real env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# But keep .env.example files (safe — they have no secrets)
!.env.example
!.env.local.example

# Build outputs
dist/
build/
.next/
out/

# Prisma — KEEP migrations (Railway needs them to run migrate deploy)
# DO NOT add: backend/prisma/migrations/

# Vercel
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/

# TypeScript incremental build cache
*.tsbuildinfo
