# ============================================================
# JEWELLERY SHOWROOM — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- DATABASE ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jewellery_showroom?schema=public"

# --- AUTHENTICATION ---
JWT_SECRET="your-very-long-random-secret-key-here-minimum-64-chars"
JWT_EXPIRY="7d"
ADMIN_DEFAULT_EMAIL="admin@yourshowroom.com"
ADMIN_DEFAULT_PASSWORD="ChangeThisPassword123!"

# --- CLOUDINARY (Image Storage) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="jewellery_products"

# --- WHATSAPP ---
# International format without +, e.g., 919876543210
WHATSAPP_NUMBER="919876543210"

# --- FRONTEND ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# --- BACKEND ---
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# --- RATE LIMITING ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
